# {
#     auto_https disable_redirects
# }

{
    email 1071426378@163.com
}

#:80 {
sunsetting.cn {
    handle_path /* {
        root * /root/html/
        file_server
        try_files {path} /
    }

    handle_path /api/* {
         rewrite * /api{path}
         reverse_proxy {$API_IP:localhost}:8190
    }
}

(all_header) {
    header_up -Via
    header_up Host embed.windy.com
    header_up -X-Forwarded-For
    header_up -X-Forwarded-Host
    header_up -X-Forwarded-Proto
    header_up Sec-Fetch-Site cross-site
    header_up Connection keep-alive
}

sunsetting.cn:9180 {
    handle_path /sunset/* {
        root * /root/html/
        file_server
        try_files {path} /
    }

    reverse_proxy /* {
        to https://embed.windy.com

        import all_header
    }
}
